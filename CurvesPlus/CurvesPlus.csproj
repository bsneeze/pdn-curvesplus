<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>pyrochild.effects.curvesplus</RootNamespace>
    <AssemblyName>Curves+</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <Product>Curves+</Product>
    <AssemblyTitle>Curves+</AssemblyTitle>
    <Description>Paint.NET Plugin</Description>
    <Company>Zach Walker, a.k.a. pyrochild</Company>
    <Copyright>Copyright © 2007-2026 Zach Walker</Copyright>

    <!-- Build/Revision come from the build date. -->
    <VersionPrefix>5.1</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(yyMM)).$([System.DateTime]::Now.ToString(ddHH))</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PaintDotNet.Base">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Core">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Data">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Effects.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Effects.Core">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Effects.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Primitives">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Primitives.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ComponentModel">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.ComponentModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.ObjectModel">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.ObjectModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Windows">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Windows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PaintDotNet.Fundamentals">
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Fundamentals.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="PresetDropdown\InputBox.resx">
      <DependentUpon>InputBox.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="images\icon.png" />
    <EmbeddedResource Include="images\line.png" />
    <EmbeddedResource Include="images\spline.png" />
    <EmbeddedResource Include="images\pencil.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Presets\Darken.xml" />
    <EmbeddedResource Include="Presets\Fade.xml" />
    <EmbeddedResource Include="Presets\Hot.xml" />
    <EmbeddedResource Include="Presets\High Contrast.xml" />
    <EmbeddedResource Include="Presets\Increase Contrast.xml" />
    <EmbeddedResource Include="Presets\Invert Luminosity.xml" />
    <EmbeddedResource Include="Presets\Invert.xml" />
    <EmbeddedResource Include="Presets\Lighten.xml" />
    <EmbeddedResource Include="Presets\Negative.xml" />
    <EmbeddedResource Include="Presets\Flip Hue.xml" />
    <EmbeddedResource Include="Presets\Black &amp; White.xml" />
    <EmbeddedResource Include="Presets\Desaturate.xml" />
  </ItemGroup>

  <Target Name="CurvesPlusRenameLockedOutput" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CurvesPlusLockedStamp>$([System.DateTime]::Now.ToString("yyyyMMddHHmmss"))</CurvesPlusLockedStamp>
    </PropertyGroup>
    <Move SourceFiles="$(TargetPath)" DestinationFiles="$(TargetPath).$(CurvesPlusLockedStamp).locked" Condition="Exists('$(TargetPath)')" ContinueOnError="true" />
  </Target>

  <PropertyGroup>
    <CurvesPlusEffectsDir>$(USERPROFILE)\Documents\paint.net App Files\Effects\</CurvesPlusEffectsDir>
  </PropertyGroup>

  <Target Name="CurvesPlusCopyToEffectsFolder" AfterTargets="Build">
    <MakeDir Directories="$(CurvesPlusEffectsDir)" Condition="!Exists('$(CurvesPlusEffectsDir)')" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CurvesPlusEffectsDir)" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
